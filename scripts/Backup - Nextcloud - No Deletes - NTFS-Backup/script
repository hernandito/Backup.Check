#!/bin/bash
# =============================================================================
#  Backup - Nextcloud - No Deletes - NTFS-Backup
#
#  What:   everyone's Nextcloud files (/mnt/user/Nextcloud)
#  Type:   No Deletes - new and changed files are copied; nothing is ever removed, so a
#          file deleted from Nextcloud stays in the backup forever. Same tripwire as the
#          FilesBackup copy.
#  To:     NTFS-Backup (readable on Windows) - a second, separate drive, so Nextcloud no
#          longer depends on FilesBackup alone.
#  When:   daily
#
#  New copy (there was no second Nextcloud backup before). The first run copies
#  everything (about 61 GB); after that only changes.
# =============================================================================
source "${BACKUP_LIB:-/boot/config/backup-scripts/backup-lib.sh}" || { echo "Backup library missing"; exit 1; }

SOURCE="/mnt/user/Nextcloud/"
DEST="/mnt/disks/NTFS-Backup/Nextcloud/"
TRIPWIRE_MAX=100          # raise for one run if you deliberately change many files

OPTS=(--exclude='/*/files_trashbin/' --exclude='/*/files_versions/')
[ "$BACKUP_DRY_RUN" = 1 ] && OPTS+=(--dry-run)

backup_start "nextcloud-nodeletes-ntfsbackup" "Nextcloud - No Deletes - NTFS-Backup"
backup_need_source  "$SOURCE"
backup_need_mounted "/mnt/disks/NTFS-Backup"

backup_tripwire ntfs "$SOURCE" "$DEST" "$TRIPWIRE_MAX" "${OPTS[@]}"
backup_nodeletes_ntfs "Nextcloud" "$SOURCE" "$DEST" "${OPTS[@]}"
backup_finish
