<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="backupcheck"
VERSION="]]>&version;<![CDATA["
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"
CACHE="$CONF/$VERSION"

# Lay down a clean copy of this version from the flash cache
rm -rf "$PLUGDIR"
mkdir -p "$PLUGDIR"
cp -r "$CACHE"/. "$PLUGDIR"/

# First install only: give the user an editable catalog (never overwrite their edits)
[ -f "$CONF/catalog.json" ] || cp "$CACHE/catalog.default.json" "$CONF/catalog.json"

# Remove cached files from older versions (keeps catalog.json)
for d in "$CONF"/*/; do
  v=$(basename "$d")
  case "$v" in
    20[0-9][0-9].[0-9][0-9].[0-9][0-9]*) [ "$v" != "$VERSION" ] && rm -rf "$d" ;;
  esac
done

chown -R root:root "$PLUGDIR"
chmod -R 755 "$PLUGDIR"

# Refresh the status every 30 minutes (reads only; USB/array paths at most every 6 hours)
echo "# Backup Check: refresh backup status" > "$CONF/$NAME.cron"
echo "*/30 * * * * /usr/bin/php $PLUGDIR/include/collect.php &> /dev/null" >> "$CONF/$NAME.cron"
# Save the daily summary file on the flash drive (CONF/summary), after the night's backups
echo "# Backup Check: save the daily summary file on the flash drive" >> "$CONF/$NAME.cron"
echo "15 9 * * * /usr/bin/php $PLUGDIR/include/summary.php &> /dev/null" >> "$CONF/$NAME.cron"
/usr/local/sbin/update_cron

# Build the first status now, in the background
( /usr/bin/php "$PLUGDIR/include/collect.php" &> /dev/null & )

echo ""
echo "----------------------------------------------------"
echo " Backup Check has been installed."
echo " Version: $VERSION"
echo " Open it at Tools > Backup Check."
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="backupcheck"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"

rm -f "$CONF/$NAME.cron"
/usr/local/sbin/update_cron
rm -rf "$PLUGDIR"
for d in "$CONF"/20[0-9][0-9].[0-9][0-9].[0-9][0-9]*/; do [ -d "$d" ] && rm -rf "$d"; done

echo ""
echo "----------------------------------------------------------------------------"
echo " Backup Check has been uninstalled."
echo " Your catalog (/boot/config/plugins/backupcheck/catalog.json), the saved daily"
echo " summaries (/boot/config/plugins/backupcheck/summary) and the status history"
echo " in the appdata backup-check folder were kept."
echo "----------------------------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>
</PLUGIN>
